# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES
# Sistem Pembukuan & Manajemen Keuangan BUMDes Catering Desa Bogem
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Format URL koneksi PostgreSQL (Local / Neon / Supabase / Render / Railway)
# Contoh Local: postgresql://username:password@localhost:5432/bumdes_bogem?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bumdes_bogem?schema=public"

# DIRECT_URL (Opsional - Diperlukan jika menggunakan connection pooling seperti Supabase / Neon)
# DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH (Autentikasi & Keamanan Sesi)
# ------------------------------------------------------------------------------
# NEXTAUTH_SECRET: String acak yang digunakan untuk mengenkripsi JWT token session.
# Generate secret baru dengan perintah terminal: `openssl rand -base64 32`
NEXTAUTH_SECRET="bumdes-bogem-catering-secret-key-super-secure-2026"

# NEXTAUTH_URL: URL aplikasi (Gunakan http://localhost:3000 saat development, atau domain production)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS API v4 (Sinkronisasi Otomatis Spreadsheet)
# ------------------------------------------------------------------------------
# Panduan lengkap setup Service Account dapat dilihat di docs/GOOGLE_SHEETS_SETUP.md

# Email Service Account dari Google Cloud Platform Console (IAM & Admin)
# Contoh: bumdes-sync@project-name.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-gcp-project.iam.gserviceaccount.com"

# Private Key Service Account (dimulai dengan "-----BEGIN PRIVATE KEY-----" dan diakhiri "-----END PRIVATE KEY-----\n")
# Jika ditempel di file .env, pastikan karakter newline (\n) tetap dipertahankan atau diapit tanda kutip ganda
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID dari URL Google Sheets:
# https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
# Pastikan spreadsheet tersebut sudah di-share (Editor) ke GOOGLE_SERVICE_ACCOUNT_EMAIL di atas
SPREADSHEET_ID="1A2B3C4D5E6F7G8H9I0J_kLMnOpQrStUvWxYz"
